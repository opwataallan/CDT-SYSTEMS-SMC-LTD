# ==============================================================================
# Cyber Dynamic Tech Marketplace - cPanel Production Apache Configuration
# Optimized for cPanel "Setup Node.js App", Phusion Passenger & Static Apache Hosting
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. HTTPS Redirection (Cloudflare, cPanel Proxy & Direct SSL aware)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 2. WordPress / WooCommerce Coexistence: Do not intercept WordPress paths
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/(wp-admin|wp-content|wp-includes|wp-json|xmlrpc\.php) [NC]
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------------
  # 3. Proxy /api requests to local Node.js backend if mod_proxy is active on cPanel
  # ----------------------------------------------------------------------------
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # ----------------------------------------------------------------------------
  # 4. Security: Block access to hidden files and directories (e.g. .git, .env)
  # ----------------------------------------------------------------------------
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # ----------------------------------------------------------------------------
  # 5. Existing files, directories and uploads are served directly
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------------
  # 6. Single Page Application (SPA) Routing: Fallback to index.html
  # ----------------------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# Security: Block sensitive application files
# ------------------------------------------------------------------------------
<FilesMatch "(^\.env|\.git|\.lock|package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts|server\.ts|database\.json|\.sql|\.log|\.sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # Cross-Site Scripting protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy
  Header always set Permissions-Policy "geolocation=(self), camera=(self)"

  # Cache Control for immutable hashed assets
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|eot|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Do NOT cache index.html or service worker so users immediately receive updates
  <FilesMatch "(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# Compression (Gzip / Deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------------------------
# Proper MIME Types
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
</IfModule>

# ------------------------------------------------------------------------------
# Browser Caching Expirations
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# Directory Browsing Disabled
# ------------------------------------------------------------------------------
Options -Indexes

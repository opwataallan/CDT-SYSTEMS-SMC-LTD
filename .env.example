# ==============================================================================
# Cyber Dynamic Technologies Marketplace — cPanel Environment Variables
# Copy this file to .env on your cPanel server or configure these in
# cPanel -> "Setup Node.js App" -> "Environment variables"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Ports (Required for cPanel Node.js App)
# ------------------------------------------------------------------------------
NODE_ENV="production"
# PORT: In cPanel "Setup Node.js App", Passenger assigns the PORT or Unix socket automatically.
# When running standalone node, specify your port (e.g. 3000, 8080).
PORT=3000

# ------------------------------------------------------------------------------
# 2. Public Store & Application URLs
# ------------------------------------------------------------------------------
# APP_URL: The public URL where this Marketplace is accessed (e.g. https://app.cyberdynamictech.com)
APP_URL="https://app.cyberdynamictech.com"

# VITE_BASE_PATH: Subdirectory path if hosting in a folder (e.g. "/shop/" or "/" for root)
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Leave empty for same-domain / relative /api calls
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 3. WooCommerce REST API Integration (Server-Side Secrets - Never exposed to client)
# ------------------------------------------------------------------------------
# Store URL of your WordPress / WooCommerce installation
WOOCOMMERCE_URL="https://www.cyberdynamictech.com"

# WooCommerce REST API Keys (Generated in WP-Admin -> WooCommerce -> Settings -> Advanced -> REST API)
# Permissions: Read/Write
WOOCOMMERCE_CONSUMER_KEY="ck_your_consumer_key_here"
WOOCOMMERCE_CONSUMER_SECRET="cs_your_consumer_secret_here"
WOOCOMMERCE_WEBHOOK_SECRET="your_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API (Server-Side - Powers AI Shopping Assistant)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. Security & Authentication Secrets (Required for secure admin/customer sessions)
# ------------------------------------------------------------------------------
# Generate 32+ character random strings for production security
ADMIN_SECRET_KEY="generate_a_long_random_string_for_admin_security_key"
SESSION_SECRET="generate_a_long_random_string_for_session_token_encryption"
# Initial password for default super admin (admin@cyberdynamictech.com)
ADMIN_INITIAL_PASSWORD="YourSecurePassword2026!"

# ------------------------------------------------------------------------------
# 6. Database Configuration (Optional MySQL/MariaDB on cPanel)
# By default, the application runs out of the box using self-contained data/database.json.
# If you created a MySQL database in cPanel (cPanel -> MySQL Databases), configure below:
# ------------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="yourcpanel_cdt_marketplace"
DB_USER="yourcpanel_cdt_user"
DB_PASSWORD="your_strong_mysql_password"

# ------------------------------------------------------------------------------
# 7. Brand Information & Contact
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Cyber Dynamic Technologies"
NEXT_PUBLIC_SITE_URL="https://www.cyberdynamictech.com"
WHATSAPP_NUMBER="+256779743101"

# ------------------------------------------------------------------------------
# 8. Mobile Money & Payment Gateways (Uganda MTN MoMo & Airtel Money)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# ------------------------------------------------------------------------------
# 9. SMS Order Notification Gateway (Africa's Talking / Twilio / Custom HTTP)
# ------------------------------------------------------------------------------
SMS_SENDER_ID="CYBERTECH"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
SMS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMS_ENDPOINT_URL=""
